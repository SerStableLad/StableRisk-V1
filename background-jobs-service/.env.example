# Background Jobs Service Configuration
# Copy this file to .env and update with your actual values

# Service Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=bg_jobs:
REDIS_RETRY_DELAY_ON_FAILOVER=100
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_LAZY_CONNECT=true
REDIS_KEEP_ALIVE=30000
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=background_jobs
DB_USER=bg_jobs_user
DB_PASSWORD=bg_jobs_password
DB_SSL=false
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000

# Job Processing Configuration
MAX_WORKERS=5
POLLING_INTERVAL=1000
JOB_TIMEOUT=300000
ENABLE_METRICS=true
ENABLE_CIRCUIT_BREAKER=true
CIRCUIT_BREAKER_THRESHOLD=0.5

# API Security
API_KEY=your-api-key-here
ADMIN_API_KEY=your-admin-api-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# External Services (if needed)
MAIN_APP_URL=http://localhost:3000
METRICS_SERVICE_URL=http://localhost:3002

# Monitoring and Alerting
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30000
ALERT_EMAIL=admin@example.com
ALERT_WEBHOOK=

# Performance Tuning
BATCH_SIZE=100
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=1000
MEMORY_LIMIT_MB=512

# Development/Testing
ENABLE_DEBUG_LOGS=false
MOCK_EXTERNAL_SERVICES=false
TEST_API_KEY=test-api-key-123
TEST_ADMIN_API_KEY=admin-test-key-456