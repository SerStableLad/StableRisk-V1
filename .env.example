# StableRisk-AI Environment Configuration

# Core API Keys
COINGECKO_API_KEY=your_coingecko_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
GITHUB_ACCESS_TOKEN=your_github_token_here

# AI Services - Gemini Flash 2.5
GEMINI_API_KEY=gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.1
GEMINI_RATE_LIMIT_PER_MINUTE=60

# MCP Server Configuration
COINGECKO_MCP_ENABLED=false
COINGECKO_MCP_SERVER_URL=https://mcp.api.coingecko.com/sse
COINGECKO_MCP_PRO_SERVER_URL=https://mcp.pro-api.coingecko.com/sse
COINGECKO_MCP_USE_PRO=false
COINGECKO_MCP_TIMEOUT=30000
COINGECKO_MCP_RETRY_ATTEMPTS=3
COINGECKO_MCP_RETRY_DELAY=1000

# Firecrawl MCP Configuration
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_ENABLED=false
FIRECRAWL_MCP_ENDPOINT=https://api.firecrawl.dev
FIRECRAWL_ROLLOUT_PERCENTAGE=10

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags (set to 'false' to disable)
FEATURE_AI_RISK_ANALYSIS=true
FEATURE_AI_MARKET_INSIGHTS=true
FEATURE_AI_TRANSPARENCY_ANALYSIS=true
FEATURE_MCP_DATA_SYNC=true
FEATURE_MCP_PRIORITY_FETCH=true
FEATURE_BACKGROUND_AI_JOBS=true
FEATURE_BACKGROUND_MCP_JOBS=true
FEATURE_AI_COST_TRACKING=true
FEATURE_HYBRID_DATA_SOURCES=true
FEATURE_PROGRESSIVE_ENHANCEMENT=true

# Cost Control
AI_DAILY_BUDGET_LIMIT=10.00
AI_EXTRACTION_COST_PER_REQUEST_USD=0.15

# Performance Settings
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stablerisk
DB_USER=stablerisk_user
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Database Connection Pool Settings
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_QUERY_TIMEOUT=10000

# NGINX Proxy Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443
NEXTJS_INTERNAL_PORT=3000

# Rate limiting
NGINX_API_RATE_LIMIT=100r/m
NGINX_ASSETS_RATE_LIMIT=200r/m

# Timeouts
NGINX_PROXY_TIMEOUT=60s
NGINX_API_TIMEOUT=120s

# Database Logging Configuration
DATABASE_LOGGING_ENABLED=true
LOGGING_QUEUE_SIZE=1000
LOGGING_BATCH_SIZE=50
LOGGING_FLUSH_INTERVAL=5000

# Performance thresholds
API_RESPONSE_TIME_THRESHOLD=2000
CACHE_HIT_RATE_THRESHOLD=0.8
DATA_QUALITY_THRESHOLD=0.9

# Logging levels
LOG_LEVEL=info
DATABASE_LOG_LEVEL=warn

# Background Jobs Service Configuration
BACKGROUND_JOBS_SERVICE_URL=http://localhost:3003
BACKGROUND_JOBS_TIMEOUT=30000
BACKGROUND_JOBS_RETRY_ATTEMPTS=3
BACKGROUND_JOBS_RETRY_DELAY=1000
BACKGROUND_JOBS_ENABLE_FALLBACK=true
BACKGROUND_JOBS_CIRCUIT_BREAKER_THRESHOLD=5
BACKGROUND_JOBS_CIRCUIT_BREAKER_RESET_TIMEOUT=60000
BACKGROUND_JOBS_HEALTH_CHECK_INTERVAL=60000

# Background Jobs Service Internal Configuration (for the background jobs service itself)
BACKGROUND_JOBS_REDIS_HOST=localhost
BACKGROUND_JOBS_REDIS_PORT=6379
BACKGROUND_JOBS_REDIS_PASSWORD=
BACKGROUND_JOBS_REDIS_DB=1
BACKGROUND_JOBS_DB_NAME=background_jobs
BACKGROUND_JOBS_DB_USERNAME=background_jobs_user
BACKGROUND_JOBS_DB_PASSWORD=your_background_jobs_password_here