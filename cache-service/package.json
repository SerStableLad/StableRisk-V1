{
  "name": "stablerisk-cache-service",
  "version": "1.0.0",
  "description": "Dedicated cache service for StableRisk AI with intelligent TTL calculation and access pattern optimization",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testNamePattern='(?!integration|performance)'",
    "test:integration": "jest --testNamePattern='integration'",
    "test:performance": "jest --testNamePattern='performance'",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run test:ci",
    "clean": "rimraf dist coverage",
    "docker:build": "docker build -t stablerisk-cache-service .",
    "docker:run": "docker run -p 3002:3002 stablerisk-cache-service"
  },
  "keywords": [
    "cache",
    "redis",
    "ttl",
    "stablecoin",
    "performance",
    "microservice"
  ],
  "author": "StableRisk AI Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "morgan": "^1.10.0",
    "rate-limiter-flexible": "^4.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "msw": "^2.10.5",
    "node-fetch": "^3.3.2",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "undici": "^7.13.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stablerisk/cache-service.git"
  },
  "bugs": {
    "url": "https://github.com/stablerisk/cache-service/issues"
  },
  "homepage": "https://github.com/stablerisk/cache-service#readme"
}
