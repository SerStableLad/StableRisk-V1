{
  "name": "stablerisk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "build:analyze": "npm run analyze",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:db-connection": "node scripts/test-db-connection.js",
    "db:migrate": "node scripts/migrate.js",
    "db:verify-schema": "node scripts/verify-schema.js",
    "proxy:start": "docker-compose up -d nginx",
    "proxy:stop": "docker-compose down nginx",
    "proxy:logs": "docker-compose logs -f nginx",
    "proxy:reload": "docker-compose exec nginx nginx -s reload",
    "dev:with-proxy": "concurrently \"npm run dev\" \"npm run proxy:start\"",
    "test:proxy": "curl -f http://localhost/nginx-health"
  },
  "dependencies": {
    "@coingecko/coingecko-mcp": "^1.11.1",
    "@mendable/firecrawl-js": "^1.29.3",
    "@modelcontextprotocol/sdk": "^1.17.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/cheerio": "^0.22.35",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.9.0",
    "cheerio": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.514.0",
    "next": "^15.3.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.1.0",
    "pg": "^8.16.3",
    "playwright": "^1.53.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.0",
    "redis": "^5.5.6",
    "swr": "^2.2.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "autoprefixer": "^10.0.1",
    "concurrently": "^9.0.1",
    "dotenv": "^17.2.1",
    "eslint": "^8",
    "eslint-config-next": "15.1.8",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.0",
    "jsdom": "^26.1.0",
    "node-fetch": "^2.7.0",
    "postcss": "^8",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
